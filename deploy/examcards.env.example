# Copy to /etc/examcards.env  (sudo chmod 640, owner root, group examcards)
APP_ENV=production

# the only host name this site answers to (requests with any other Host header are rejected)
ALLOWED_HOSTS=app.example.com

# the app runs behind nginx on the same machine: trust its X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=1

# everything that changes at runtime lives here, outside the code folder, so updates never touch it
DATA_DIR=/var/lib/examcards/data
SUBJECTS_DIR=/var/lib/examcards/subjects
PICTURE_DIR=/var/lib/examcards/pictures

# SECRET_KEY is generated automatically into DATA_DIR/secret_key (readable by the owner only).
# Set it here only if you want to manage it yourself:
# SECRET_KEY=
